{
  "name": "shadow-claw-single-file",
  "version": "1.0.0",
  "description": "ShadowClaw in a single file",
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "npx -y shadow-claw build --single-file",
    "build:base": "npm run build -- --base-path \"/shadow-claw-single-file/\"",
    "build:copy": "npx -y ncp dist/public/index.html ./index.html",
    "start": "npx serve -s ."
  },
  "devDependencies": {
    "ncp": "^2.0.0",
    "serve": "^14.2.6",
    "shadow-claw": "^1.59.5"
  }
}
